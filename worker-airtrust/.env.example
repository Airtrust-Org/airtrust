# ===== WORKER ENVIRONMENT VARIABLES =====
# Copy to .dev.vars for local development (never commit .dev.vars)

# ===== REQUIRED SECRETS (via wrangler secret put) =====
JWT_SECRET=your-256-bit-secret-here

# ===== ENVIRONMENT =====
ENVIRONMENT=development
# Options: development | staging | production

# ===== URLS =====
API_URL=http://localhost:8787
FRONTEND_URL=http://localhost:5173

# ===== LOGGING =====
LOG_LEVEL=info
# Options: debug | info | warn | error

# ===== FEATURE FLAGS =====
ENABLE_DEV_AUTH_BYPASS=false
# Set to "true" ONLY in development to skip JWT verification
USE_INTEGRATED_VIEW=false
DEBUG=false

# ===== CACHE =====
CACHE_TTL_SECONDS=30

# ===== EMAIL (optional) =====
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com

# ===== WHATSAPP (optional) =====
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# ===== TWILIO WHATSAPP FALLBACK (optional) =====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# ===== EDAPP INTEGRATION (optional) =====
EDAPP_API_TOKEN=
EDAPP_WEBHOOK_SECRET=

# ===== CLOUDFLARE BROWSER RENDERING (optional) =====
CF_ACCOUNT_ID=
CF_BROWSER_API_TOKEN=

# ===== APP BUILD INFO (auto-set by deploy) =====
APP_VERSION=
APP_BUILD_TIME=
