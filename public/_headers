# ===== CLOUDFLARE PAGES - HEADERS CONFIGURATION =====
# Documentação: https://developers.cloudflare.com/pages/configuration/headers/
#
# Este arquivo configura headers HTTP para todas as rotas do frontend
# Cloudflare Pages aplica automaticamente durante o deploy

# ===== HEADERS GLOBAIS (TODAS AS ROTAS) =====
/*
  # Segurança
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self' blob:; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: https: blob:; font-src 'self' data: https: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' blob:; connect-src 'self' https://api.airtrust.online https://airtrust-api-staging.airtrust.workers.dev; worker-src 'self' blob:; form-action 'self'; manifest-src 'self'; frame-src 'self' blob: https://api.airtrust.online https://airtrust-api-staging.airtrust.workers.dev https://view.officeapps.live.com

# ===== HTML - NUNCA CACHEAR =====
# Garante que usuários sempre vejam a versão mais recente do app
/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/login
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/instalar
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/dashboard
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/dashboard/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/mro
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/mro/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/frms
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/frms/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# ===== JAVASCRIPT - CACHE LONGO (com hash) =====
# Apenas assets versionados por hash devem receber cache imutavel.
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

# ===== CSS - CACHE LONGO (com hash) =====
/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# ===== FONTES - CACHE LONGO =====
/*.woff
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.ttf
  Cache-Control: public, max-age=31536000, immutable

/*.eot
  Cache-Control: public, max-age=31536000, immutable

# ===== IMAGENS - CACHE MODERADO =====
# Imagens podem não ter hash, cache de 1 semana
/*.png
  Cache-Control: public, max-age=604800

/*.jpg
  Cache-Control: public, max-age=604800

/*.jpeg
  Cache-Control: public, max-age=604800

/*.gif
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800

/*.ico
  Cache-Control: public, max-age=604800

# ===== MANIFEST E CONFIG - CACHE CURTO =====
/app.webmanifest
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

# Pages não é proxy autenticado da API. Este bloco é fail-closed para qualquer
# requisição /api/* que alcance a superfície Pages por engano.
/api/*
  Cache-Control: private, no-store, no-cache, must-revalidate, max-age=0, s-maxage=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
  Pragma: no-cache
  Expires: 0
  Vary: Authorization, Cookie
