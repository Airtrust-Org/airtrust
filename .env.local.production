# ============================================================================
# 🔴 CONFIGURAÇÃO PARA RODAR LOCALMENTE COM DADOS DE PRODUÇÃO
# ============================================================================
# ⚠️  CUIDADO: Isto carrega dados REAIS de produção localmente
# Use apenas para debug e testes em ambiente seguro

# ============================================================================
# CLOUDFLARE WORKERS & D1 (Production Database)
# ============================================================================

# API remota (Cloudflare Workers Production)
VITE_API_URL=https://api.airtrust.com.br

# Para dev local, pode usar também:
# VITE_API_URL=http://localhost:8787

# ============================================================================
# R2 (Cloudflare Object Storage - Production)
# ============================================================================
R2_BUCKET_NAME=airtrust-storage
R2_ACCOUNT_ID=${CLOUDFLARE_ACCOUNT_ID}
R2_ACCESS_KEY_ID=${CLOUDFLARE_R2_ACCESS_KEY_ID}
R2_SECRET_ACCESS_KEY=${CLOUDFLARE_R2_SECRET_ACCESS_KEY}
R2_REGION=auto

# ============================================================================
# D1 Database (Cloudflare - Production)
# ============================================================================
D1_DB_ID=${CLOUDFLARE_D1_DB_ID}
D1_AUTH_TOKEN=${CLOUDFLARE_AUTH_TOKEN}

# ============================================================================
# Autenticação
# ============================================================================
JWT_SECRET=${PRODUCTION_JWT_SECRET}

# ============================================================================
# Frontend Configuration
# ============================================================================
NODE_ENV=development
VITE_ENVIRONMENT=production-local
VITE_LOG_LEVEL=debug

# ============================================================================
# IMPORTANTE: Como usar este arquivo
# ============================================================================
# 
# 1. Preencha os valores com suas credenciais de Cloudflare:
#    export CLOUDFLARE_ACCOUNT_ID="your-account-id"
#    export CLOUDFLARE_R2_ACCESS_KEY_ID="your-access-key"
#    export CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-secret-key"
#    export CLOUDFLARE_D1_DB_ID="your-db-id"
#    export CLOUDFLARE_AUTH_TOKEN="your-auth-token"
#    export PRODUCTION_JWT_SECRET="your-jwt-secret"
#
# 2. Execute:
#    export $(cat .env.local.production | xargs)
#    npm run dev
#
# 3. Acesse: http://localhost:3000
#
# ============================================================================
