# ==========================================
# AIRTRUST v1 - PRODUCTION ENVIRONMENT
# ==========================================

# === AMBIENTE ===
ENVIRONMENT=production

# === FRONTEND API URL ===
# Worker em produção: https://airtrust.airtrust.workers.dev
# IMPORTANTE: Usar a MESMA chave usada no código (VITE_API_URL)
VITE_API_URL=https://airtrust.airtrust.workers.dev/api

# === DEFAULT LOGIN CREDENTIALS ===
# Nunca defina credenciais padrão em produção.
# Use somente variáveis injetadas via CI/CD para ambientes de desenvolvimento.

# === AUTENTICAÇÃO ===
# Autenticação JWT ATIVA
VITE_AUTH_ENABLED=true

# === CORS ===
CORS_ALLOWED_ORIGINS=https://airtrust.pages.dev,https://production.airtrust.pages.dev

# === PRODUCTION FLAGS ===
VITE_ENABLE_DEBUG=false
VITE_ENABLE_ANALYTICS=true

# === LOG LEVEL ===
LOG_LEVEL=info
