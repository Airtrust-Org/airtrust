  "scripts": {
    "dev": "vite --port 3000 --host",
    "dev:safe": "npm start",
    "dev:worker": "cd worker-airtrust && wrangler dev --env development --port 8787 --remote",
    "dev:worker:local": "cd worker-airtrust && wrangler dev --port 8787 --config wrangler.dev.toml --local",
    "dev:worker:safe": "npm run dev:worker:local",
    "start": "concurrently --names \"worker,vite\" --prefix-colors \"cyan,green\" \"npm run dev:worker:local\" \"npm run dev\"",
    "auth:setup": "node scripts/login-airtrust.mjs",
    "auditar-vencimento": "node scripts/auditar-vencimento-fim-mes.mjs",
    "auditar-vencimento:fix": "node scripts/auditar-vencimento-fim-mes.mjs --mode=fix",
    "matricular-mel": "node scripts/matricular-manutencao-mel.mjs",
    "matricular-mel:apply": "node scripts/matricular-manutencao-mel.mjs --mode=apply",
    "prebuild": "echo '\n⚠️  BANCO DE PRODUÇÃO ATIVO — alterações afetam usuários reais!\n'",
    "build": "vite build && bash scripts/remove-duplicate-build-assets.sh",
    "typecheck": "npm run typecheck:ratchet",
    "typecheck:strict": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:worker": "cd worker-airtrust && npx tsc --noEmit",
    "build:clean": "rm -rf dist node_modules/.vite .vite && vite build && bash scripts/remove-duplicate-build-assets.sh",
    "preview": "npm run build && vite preview --port 3000 --host",
    "deploy": "bash -lc 'eval \"$(bash scripts/generate-version.sh)\" && npm run build && npm run deploy:pages && APP_VERSION=\"$APP_VERSION\" APP_BUILD_TIME=\"$APP_BUILD_TIME\" npm run deploy:worker:only -- \"$APP_VERSION\"'",
    "deploy:pages": "bash scripts/preflight-clean-deploy.sh && npm run build && bash scripts/remove-duplicate-build-assets.sh && bash scripts/stamp-build-version.sh dist/client/index.html && env -u CLOUDFLARE_API_TOKEN wrangler pages deploy dist/client --project-name=airtrust --branch=production",
    "deploy:worker": "bash -lc 'eval \"$(bash scripts/generate-version.sh)\" && APP_VERSION=\"$APP_VERSION\" npm run build && APP_VERSION=\"$APP_VERSION\" APP_BUILD_TIME=\"$APP_BUILD_TIME\" npm run deploy:worker:only -- \"$APP_VERSION\"'",
    "deploy:worker:only": "bash scripts/deploy-worker-only.sh",
    "deploy:worker:safe": "bash scripts/deploy-worker-safe.sh",
    "deploy:staging:worker:safe": "bash scripts/deploy-staging-worker-safe.sh",
    "repo:doctor": "node scripts/airtrust-repo-doctor.mjs",
    "release:status": "npm run repo:doctor",
    "release:worker:local-emergency": "bash scripts/release-worker-local-emergency.sh",
    "deploy:all": "chmod +x scripts/build-and-deploy.sh && ./scripts/build-and-deploy.sh",
    "ops:guard": "bash scripts/audit-dangerous-ops.sh",
    "guard:duplicate-migrations": "node scripts/check-duplicate-migrations.mjs",
    "guard:no-go-migrations": "node scripts/check-no-go-migrations.mjs",
    "guard:migrations": "npm run guard:duplicate-migrations && npm run guard:no-go-migrations",
    "guard:operational-sql-sources": "node scripts/check-operational-sql-sources.mjs",
    "validate:data-quality-sql": "bash scripts/validation/validate-data-quality-sql.sh",
    "data-quality:local": "bash scripts/validation/run-data-quality-local.sh",
    "integrity:local": "bash -lc 'db=\"${AIRTRUST_INTEGRITY_DB:-}\"; if [[ -z \"$db\" ]]; then for dir in worker-airtrust/.wrangler/state/v3/d1/miniflare-D1DatabaseObject .wrangler/state/v3/d1/miniflare-D1DatabaseObject; do [[ -d \"$dir\" ]] || continue; cand=$(find \"$dir\" -maxdepth 1 -type f -name \"*.sqlite\" ! -name \"metadata.sqlite\" | head -n1); if [[ -n \"$cand\" ]]; then db=\"$cand\"; break; fi; done; fi; if [[ -z \"$db\" ]]; then echo \"No local D1 sqlite snapshot found. Run npm run setup:lms:local:reset or set AIRTRUST_INTEGRITY_DB.\" >&2; exit 1; fi; args=(node scripts/integrity/run-integrity.mjs --db \"$db\" --fail-on-severity \"${AIRTRUST_INTEGRITY_FAIL_ON_SEVERITY:-P0}\"); if [[ -n \"${AIRTRUST_INTEGRITY_BASELINE:-}\" ]]; then args+=(--baseline \"$AIRTRUST_INTEGRITY_BASELINE\"); fi; \"${args[@]}\"'",
    "integrity:ci": "AIRTRUST_INTEGRITY_FAIL_ON_SEVERITY=P1 npm run integrity:local",
    "test": "vitest",
    "test:run": "vitest run",
    "test:guard:sw-cache": "vitest run src/__tests__/service-worker-cache.test.ts",
    "test:worker": "cd worker-airtrust && npx vitest run",
    "test:all": "npm run test:run && npm run test:worker",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "setup:dev": "bash worker-airtrust/setup-dev-db.sh",
    "setup:local": "bash scripts/setup-local-db.sh",
    "setup:local:reset": "bash scripts/setup-local-db.sh --reset",
    "setup:lms:local:reset": "bash scripts/setup-local-lms-smoke-db.sh --reset",
    "seed:lms:pdf:local": "bash scripts/seed-lms-pdf-demo.sh",
    "seed:lms:pptx:local": "bash scripts/seed-lms-pptx-demo.sh",
    "smoke:lms:local": "bash scripts/smoke-lms-content-local.sh",
    "storage:r2:bootstrap": "bash scripts/bootstrap-remote-r2-buckets.sh",
    "db:init": "chmod +x scripts/init-db.sh && ./scripts/init-db.sh",
    "db:status": "sqlite3 .wrangler/state/v3/d1/miniflare-D1DatabaseObject/*.sqlite 'SELECT name FROM sqlite_master WHERE type=\"table\" ORDER BY name;'",
    "db:qualificacoes:legacy-safe": "bash scripts/run-production-db-script.sh sql/maintenance/2026-04-01-qualificacoes-legacy-codigo-safe-merge.sql",
    "db:qualificacoes:legacy-audit": "bash scripts/run-production-db-script.sh sql/maintenance/2026-04-01-qualificacoes-legacy-codigo-residual-audit.sql",
    "db:qualificacoes:fap14-sk76": "bash scripts/run-production-db-script.sh sql/maintenance/2026-04-01-fap14-sk76-reclass.sql",
    "logs:tail": "bash -lc 'if [[ \"${AIRTRUST_ALLOW_PROD_TAIL:-}\" != \"YES\" ]]; then echo \"Production tail blocked. Set AIRTRUST_ALLOW_PROD_TAIL=YES in an approved ops window.\" >&2; exit 1; fi; cd worker-airtrust && npx wrangler tail --env production'",
    "logs:errors": "chmod +x scripts/analyze-logs.sh && ./scripts/analyze-logs.sh ERROR 60",
    "smoke:assets-public": "bash scripts/smoke-assets-public.sh",
    "smoke:auth:login": "bash scripts/smoke-auth-login.sh",
    "smoke:staging:auth": "node scripts/smoke-staging-auth.mjs && node scripts/staging/smoke-rdv-cas.mjs && node scripts/staging/smoke-certificado-auth.mjs",
    "smoke:production:auth": "node scripts/smoke-production-auth.mjs",
    "staging:doctor": "node scripts/staging-doctor.mjs",
    "smoke:core:prod": "BASE=https://api.airtrust.online bash scripts/smoke-test-core.sh",
    "sync:prod:local:safe": "bash scripts/sync-d1-production-sanitized.sh --target local",
    "sync:prod:dev:safe": "bash scripts/sync-d1-production-sanitized.sh --target development",
    "smoke:core:local": "BASE=http://localhost:8787 bash scripts/smoke-test-core.sh",
    "health": "curl -s http://localhost:8787/health | python3 -m json.tool",
    "guard:auth-boundaries": "bash scripts/guard-auth-boundaries.sh",
    "guard:tracked-secrets": "bash scripts/check-tracked-secrets.sh",
    "check:demo-data": "bash scripts/ci-demo-data-check.sh && bash scripts/production-audit-check.sh",
    "lint:api-base": "bash scripts/guard-tenant-mutations.sh && chmod +x scripts/lint-api-base.sh && ./scripts/lint-api-base.sh",
    "guard:empresa-default1": "bash scripts/guard-no-new-empresa-default1.sh",
    "guard:typescript-delta": "node scripts/guard-typescript-delta.mjs",
    "guard:frms-no-direct-sigvoos": "node scripts/guard-frms-no-direct-sigvoos.cjs",
    "guard:staging-version-stamp": "node scripts/guard-staging-version-stamp.mjs",
    "guard:local-maintenance-runtime": "node scripts/guard-local-maintenance-runtime.mjs",
    "guard:worker-bundle-provenance": "node scripts/guard-worker-bundle-provenance.mjs",
    "guard:cloudflare-secret-contract": "node scripts/ci/guard-cloudflare-secret-contract.mjs",
    "guard:sanitization": "node scripts/guard-sanitization.mjs",
    "guard:pii-delta": "node scripts/guard-pii-delta.mjs",
    "guard:package-references": "node scripts/guard-package-references.mjs",
    "guard:route-ownership": "node scripts/guard-route-ownership.mjs",
    "typecheck:ratchet": "node scripts/guard-typescript-baseline-ratchet.mjs",
    "lint": "npm run lint:api-base && npm run guard:tracked-secrets && npm run guard:operational-auth-literals && npm run guard:auth-boundaries && npm run guard:empresa-default1 && npm run guard:duplicate-migrations && npm run guard:no-go-migrations && npm run guard:operational-sql-sources && npm run guard:typescript-delta && npm run guard:frms-no-direct-sigvoos && npm run guard:staging-version-stamp && npm run guard:local-maintenance-runtime && npm run guard:worker-bundle-provenance && npm run guard:cloudflare-secret-contract && npm run guard:sanitization && npm run guard:pii-delta && npm run guard:no-raw-fetch && npm run guard:package-references && npm run guard:route-ownership",
    "guard:no-raw-fetch": "node scripts/guard-no-raw-fetch.mjs",
    "guard:operational-auth-literals": "node scripts/guard-operational-auth-literals.mjs"
  }
